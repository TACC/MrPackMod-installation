################################################################
####
#### Makefile for Kokkos installation
####
################################################################

PACKAGE = kokkos
PACKAGEVERSION = 5.2.0
# 5.2.1
# also 4.7.04
ABOUT = C++ Performance Portability Programming Ecosystem
URL = https://github.com/kokkos/kokkos
DOCURL = https://kokkos.github.io/kokkos-core-wiki/building.html
DOWNLOADURL = https://github.com/kokkos/kokkos/archive/refs/tags/${PACKAGEVERSION}.tar.gz
GITREPO = https://github.com/kokkos/kokkos.git

MODE = seq
MODULES = 

BUILDSYSTEM = cmake
CMAKEFLAGS = \
    -D Kokkos_ENABLE_SERIAL=ON -D Kokkos_ENABLE_OPENMP=ON 
HASBIN = 1
PREFIXPATHSET = 1
SRCPATH = ${PACKAGEROOT}/kokkos/kokkos-${PACKAGEVERSION}
INSTALLEXT = omp
INSTALLVARIANT = omp
MODULEVERSIONEXTRA = omp

SYSTEM==fontera   HOST = CLX
SYSTEM==ls6       HOST = MILAN
SYSTEM==stampede3 HOST = SPR

