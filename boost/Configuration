################################################################
####
#### Makefile for Boost installation
####
################################################################

PACKAGE = boost
ABOUT = C++ Libraries
CATEGORY = library, programming

# Starting 1.90 uses cmake!
PACKAGEVERSION = 1.92.0
DOWNLOADURL = https://github.com/boostorg/boost/releases/download/boost-${PACKAGEVERSION}/boost-${PACKAGEVERSION}-cmake.tar.gz

URL = https://www.boost.org/
GITREPO = https://github.com/boostorg/boost
MODE = seq

BUILDSYSTEM = cmake

EXTRAFLAGS =
COMPILER==nvidia EXTRAFLAGS = '-D CMAKE_CXX_FLAGS=-Wc,--max_depth_constexpr_call=1024'

MODULES = 
CMAKEFLAGS = \
  -D CMAKE_CXX_STANDARD=17 \
  ${EXTRAFLAGS} \
  -D BOOST_ENABLE_MPI=OFF
PREFIXPATHSET = 1

